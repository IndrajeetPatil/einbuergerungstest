{
  "name": "einbuergerungstest",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual practice and progress tracking for the German Einbürgerungstest",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*",
    "#data/*": "./src/data/*",
    "#server/*": "./server/*"
  },
  "scripts": {
    "start": "node server/serve.ts --open",
    "file-naming": "ls-lint",
    "css-quality": "node scripts/css-quality.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ls-lint/ls-lint": "2.3.2",
    "@playwright/test": "1.64.1",
    "@projectwallace/css-code-quality": "^3.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fallow": "^3.37.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
